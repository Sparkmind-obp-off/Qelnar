{
  "name": "qelnar-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --platform=browser --conditions=worker,browser --target=es2022 --outfile=dist/_worker.js --minify --legal-comments=none",
    "build": "npm run build:web && npm run build:worker && cp public/_routes.json dist/_routes.json",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply qelnar-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply qelnar-production --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name qelnar-one --branch main"
  },
  "dependencies": {
    "@clerk/backend": "^3.29.0",
    "@clerk/react": "^6.18.8",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
